# Server
PORT=3000
HOST=0.0.0.0

# MongoDB
MONGODB_URI=mongodb://localhost:27017/loowid

# Session
SESSION_SECRET=change-me-to-a-random-string

# HTTPS (optional - leave empty for HTTP only)
# SSL_KEY_PATH=./private.pem
# SSL_CERT_PATH=./public.pem

# TURN/STUN (optional)
# COTURN_SERVER=turn.example.com:3478
# COTURN_AUTH_USERNAME=user
# COTURN_AUTH_SECRET=secret
# COTURN_AUTH_HOURS=24
# COTURN_EXCLUSIVE=false

# Screen sharing Chrome extension ID (optional)
# CEXTID=your-extension-id

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# LTI (optional)
# LTI_KEY=key
# LTI_SECRET=secret
# LTI_PATH=/lti
# LTI_DOMAIN=
# LTI_OWNER_ROLES=Instructor

# WebSocket host override (optional)
# WS_HOST=your-host.com
# WS_PORT=443
